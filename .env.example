# Merge into .env.local; preserve existing values. Never commit .env.local.
# The API never falls back to in-memory data in postgres mode.
BACKEND_DATA_MODE=postgres
# SERVER ONLY: runtime connection for the restricted our_ground_api role.
# Pooler format: postgresql://our_ground_api.PROJECT_REF:ENCODED_PASSWORD@COPIED_HOST:6543/postgres
DATABASE_URL=
# SERVER / LOCAL TOOL ONLY: migration-owner direct or session-pooler connection.
# Never use this owner connection as DATABASE_URL or put it in a VITE_ variable.
MIGRATION_DATABASE_URL=
# Explicitly identifies the intended DEVELOPMENT project before tools write to it.
SUPABASE_DEV_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional geocoding credential. Without it, ALLOW_DEMO_DATA=true supports only
# the two documented demo cities/ZIP codes; no statewide lookup is claimed.
MAPBOX_ACCESS_TOKEN=
# Enable deliberately for fictional seed records, even in a real dev database.
ALLOW_DEMO_DATA=false
API_PORT=8787
# BROWSER PUBLIC values: same Supabase project as the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional Mapbox PUBLIC token (pk...). List mode works without a map token.
VITE_MAPBOX_PUBLIC_TOKEN=
# Optional in-memory demo assignment; requires a real validated Auth session.
DEMO_EDITOR_USER_ID=
# Google OAuth client ID/secret go in Supabase's Google provider settings,
# not this application. No Supabase service-role key is required.
# Optional live-test settings (fresh Supabase sessions; NEVER VITE_):
INTEGRATION_STAFF_ACCESS_TOKEN=
INTEGRATION_OUTSIDER_ACCESS_TOKEN=
